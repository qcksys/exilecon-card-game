# @currentEnv=$APP_ENV
# @generateTsTypes(path=env.d.ts)
# @defaultRequired=true
# @defaultSensitive=false
# @plugin(@varlock/1password-plugin)
# @cache="disk"
# @initOp(token=$OP_SERVICE_ACCOUNT_TOKEN, allowAppAuth=true, cacheTtl="12h")
# ---

# Which environment's values to load: local (dev server, Turnstile test keys) or prod (card.poe.boats)
# @type=enum(local, prod) @internal
APP_ENV=local

# Optional 1Password service account token; without it the 1Password desktop app is used
# @type=opServiceAccountToken @sensitive @internal @required=false
OP_SERVICE_ACCOUNT_TOKEN=

# 1Password item ("exilecon-card-game" in the Automated vault) holding this site's secrets.
# Item fields and variable names match. GitHub Actions doesn't read 1Password: the deploy job gets
# the same names from repository secrets mirrored from this item, and those env values win.
# @internal
OP_ITEM=op://v3zxer3deg52xqcutwk7pdfeey/ffnyvxsbxh4oolzfwawkylf74e

# Anthropic API key used by /api/scan
# @sensitive
ANTHROPIC_API_KEY=op("${OP_ITEM}/ANTHROPIC_API_KEY")

# Turnstile site key (public, rendered into the page). Locally: Cloudflare's always-pass test key.
TURNSTILE_KEY=if(forEnv(local), "1x00000000000000000000AA", op("${OP_ITEM}/TURNSTILE_KEY"))

# Turnstile secret key. Locally: Cloudflare's always-pass test secret.
# @sensitive
TURNSTILE_SECRET=if(forEnv(local), "1x0000000000000000000000000000000AA", op("${OP_ITEM}/TURNSTILE_SECRET"))

# Kill switch for the AI card scan
# @type=boolean
SCAN_ENABLED=true
