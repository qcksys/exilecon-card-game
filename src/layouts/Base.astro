---
import "../styles/global.css";

interface Props {
    title: string;
    description?: string;
    active?: "rules" | "cards" | "fight";
}

const {
    title,
    description = "Rules, card inventory and fight calculator for the ExileCon 2026 card game.",
    active,
} = Astro.props;
const fullTitle =
    title === "ExileCon 2026 Card Game" ? title : `${title} · ExileCon 2026 Card Game`;
const nav = [
    { href: "/", label: "Rules", key: "rules" },
    { href: "/cards/", label: "My cards", key: "cards" },
    { href: "/fight/", label: "Fight", key: "fight" },
] as const;
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
        <meta name="description" content={description} />
        <meta name="theme-color" content="#0f0e0c" />
        <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
        <link rel="manifest" href="/manifest.webmanifest" />
        {
            import.meta.env.PROD ? (
                <script is:inline>
                    if ("serviceWorker" in navigator) {
                        window.addEventListener("load", () => navigator.serviceWorker.register("/sw.js"));
                    }
                </script>
            ) : null
        }
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=Cinzel:wght@600;700&family=Inter:wght@400;500;600;700&display=swap"
            rel="stylesheet"
        />
        <title>{fullTitle}</title>
    </head>
    <body class="min-h-dvh">
        <header class="sticky top-0 z-20 border-b border-edge bg-ink/95 backdrop-blur">
            <div class="mx-auto flex max-w-3xl items-center gap-2 px-3 py-2.5 sm:px-4">
                <a href="/" class="whitespace-nowrap font-display text-sm font-bold tracking-wide text-gold sm:text-lg">
                    ExileCon Cards
                </a>
                <nav class="ml-auto flex gap-0.5 text-sm font-medium sm:gap-1">
                    {
                        nav.map((n) => (
                            <a
                                href={n.href}
                                class:list={[
                                    "whitespace-nowrap rounded-full px-2.5 py-1.5 transition-colors sm:px-3",
                                    active === n.key ? "bg-gold text-ink" : "text-muted hover:text-text",
                                ]}
                            >
                                {n.label}
                            </a>
                        ))
                    }
                </nav>
            </div>
        </header>
        <main class="mx-auto max-w-3xl px-4 pb-24 pt-4">
            <slot />
        </main>
        <footer class="mx-auto max-w-3xl px-4 pb-10 text-xs text-muted">
            Fan-made and unofficial. Staff at the venue have the final word.{" "}
            <a class="underline" href="https://github.com/qcksys/exilecon-card-game">Source</a>
        </footer>
    </body>
</html>
